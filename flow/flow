#!/usr/bin/env bash
# 手动入口(dispatcher)。触发器无关的核心件都在 lib/,这里只做转发。
# 用法:./flow <verify|review|secret|check|status> [--range R]
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)

cmd="${1:-help}"; shift || true
case "$cmd" in
  verify) exec "$here/lib/verify.sh" "$@" ;;
  review) exec "$here/lib/review.sh" "$@" ;;
  secret) exec "$here/lib/secret-scan.sh" "$@" ;;
  state)   exec "$here/lib/state.sh" "$@" ;;
  approve) exec "$here/lib/record.sh" approve "$@" ;;
  summary) exec "$here/lib/record.sh" summary "$@" ;;
  learn)   exec "$here/lib/record.sh" learn "$@" ;;
  complete)
    # 完成权:跑验证,全绿才由 verify.sh 写 done。给了 slice-id 则切片级,否则任务级。
    if [ -n "${1:-}" ]; then exec "$here/lib/verify.sh" --complete-slice "$1"
    else exec "$here/lib/verify.sh" --complete; fi
    ;;
  check)
    # 全门顺跑:任一非零即停并透传退出码
    "$here/lib/secret-scan.sh" "$@" && \
    "$here/lib/verify.sh"      "$@" && \
    "$here/lib/review.sh"      "$@"
    ;;
  status)
    "$here/lib/state.sh" show
    printf '位置(据 artifact 推导): %s\n' "$("$here/lib/state.sh" derive)"
    ;;
  help|*)
    cat >&2 <<'EOF'
用法: ./flow <命令> [参数]
  verify              跑 spec.md 验收命令(完成权门禁)
  complete [slice-id] 跑验证,全绿才写 done(任务级/切片级;done 唯一入口)
  review              跨模型二审 diff(需 FLOW_REVIEW_CMD)
  secret              扫密钥
  check               secret + verify + review 全跑
  approve [决议]      写 .flow/approved(grill 对齐后)
  summary <文本>      追加 .flow/summary.md(implement 记账)
  learn <文本>        追加 .flow/learnings.md(retro 回写)
  state <init|step|slice|show>  读写任务状态(不能写 done)
  status              打印 .flow/state
退出码: 0=过 / 1=拦 / 2=错
EOF
    [ "$cmd" = help ] && exit 0 || exit 2
    ;;
esac
